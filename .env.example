# Postgres connection strings.
# On Vercel these are set for you when you add a Neon database from the Storage tab.
# Locally, point both at the same database (e.g. a free Neon branch or a local Postgres).
DATABASE_URL="postgresql://user:password@localhost:5432/pawnup"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/pawnup"
