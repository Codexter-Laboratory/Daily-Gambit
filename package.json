{
  "name": "daily-gambit",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @daily-gambit/web",
    "dev:api": "npm run dev -w @daily-gambit/api",
    "build": "npm run build -w @daily-gambit/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
