generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model PuzzleRushSnapshot {
  id           Int      @id @default(autoincrement())
  username     String
  asOf         DateTime

  attemptsTotal Int?
  scoreTotal    Int?
  /// Best single Puzzle Rush run on this day. Chess.com has no history endpoint, so this
  /// column is how the best-score chart is built up over time.
  bestScore     Int?

  fetchedAt    DateTime @default(now())

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([username, asOf])
  @@index([username, asOf])
}

model DailyPuzzleCheckin {
  id       Int      @id @default(autoincrement())
  username String
  asOf     DateTime
  solved   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([username, asOf])
  @@index([username, asOf])
}

