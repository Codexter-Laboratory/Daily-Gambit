# Postgres connection strings.
# On Vercel these are set for you when you add a Neon database from the Storage tab.
# Locally, point both at the same database (e.g. a free Neon branch or a local Postgres).
DATABASE_URL="postgresql://user:password@localhost:5432/dailygambit"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/dailygambit"

# URL of the analysis API (apps/api). Leave unset to analyse in the browser instead.
NEXT_PUBLIC_API_URL="http://localhost:4000"
