# Postgres for analysed games.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dg_api"
# Redis for the job queue.
REDIS_URL="redis://localhost:6379"
# Web origins allowed to call the API from a browser (CORS), comma-separated. A leading *. matches any subdomain,
# for example "https://my-app.vercel.app,https://*.vercel.app" to also allow preview deployments.
WEB_ORIGIN="http://localhost:3000"
PORT=4000
# Stockfish: depth, and how many engine processes one job uses.
ENGINE_DEPTH=12
# ENGINES_PER_JOB=4
# Use a native Stockfish binary if you have one (much faster). Without it the bundled WebAssembly build runs under Node.
# STOCKFISH_PATH=/usr/games/stockfish
# Run the worker inside the API process (default outside production). Set to false and run `npm run start:worker` separately to scale.
# EMBED_WORKER=true
